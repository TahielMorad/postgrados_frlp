# ──────────────────────────────────────────────────────────────
# .env.example — Variables de entorno de referencia (desarrollo)
#   cp .env.example .env
# docker compose lee este .env automáticamente. Nunca commitear .env.
# ──────────────────────────────────────────────────────────────

# Base de datos (servicio "postgres" del compose)
DB_USER=postgrado_user
DB_PASSWORD=postgrado_dev_password
DB_NAME=postgrado_dev
# Puerto publicado en el host (cambialo si ya tenés un Postgres local en 5432)
DB_PORT=5432

# URL para correr el backend FUERA de Docker (uv run uvicorn ...).
# Dentro del compose el backend usa el host "postgres" y la arma solo.
DATABASE_URL=postgresql://postgrado_user:postgrado_dev_password@localhost:5432/postgrado_dev

# Backend (FastAPI)
BACKEND_PORT=8000
JWT_SECRET=cambiar_en_produccion_por_secreto_seguro_de_minimo_32_caracteres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
FRONTEND_PORT=5173
